<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Home Page</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <%- include('partials/header') %>

    <main class="container">
      <div class="card">
        <%- include('partials/errors') %>

        <h1>Home</h1>
        <p class="muted">Limited to images with size under 10MB</p>

        <form action="/upload" method="post" enctype="multipart/form-data">
          <label for="upload_file">Choose file</label>
          <input id="upload_file" type="file" name="upload_file" />

          <label for="folders">Choose folder:</label>
          <select name="folder_id" id="folders">
            <option value="">Select</option>
            <% userFolders.forEach(item => { %>
            <option value="<%= item.folderId %>"><%= item.folderName %></option>
            <% }) %>
          </select>

          <div style="margin-top: 12px">
            <button type="submit">Upload File</button>
          </div>
        </form>

        <hr />
        <h3>Your folders</h3>
        <%- include('partials/userFolders') %>
      </div>
    </main>

    <%- include('partials/footer') %>
  </body>
</html>
